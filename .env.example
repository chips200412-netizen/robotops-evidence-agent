# LLM 配置（OpenAI 兼容接口，当前接入 DeepSeek）
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，严禁提交
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# 每次 LLM 请求超时（秒，正数）；SDK 重试关闭，应用封装最多重试一次
OPENAI_TIMEOUT_SECONDS=30

# RAG Embedding 模型（本地 sentence-transformers；默认中文专用 bge-small-zh-v1.5）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索相似度阈值（低于该值的命中被过滤，触发「知识库未匹配」，可选；默认 0.6）
RETRIEVAL_SIMILARITY_THRESHOLD=0.6

# MOD-019 · 服务端权威会话与 LangGraph SQLite checkpoint（本地单进程）
# 生产持久化后端需另做 ADR；该文件及 -wal/-shm 已被 .gitignore 排除
DIAGNOSTIC_SESSION_DB_PATH=data/robotops-sessions.sqlite3

# 阶段4 · MySQL（docker-compose up -d mysql；宿主机映射 3307）
# 复制 .env.example 为 .env 后自行生成强密码，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=robot
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=robot_support
# MOD-029B 本地 Compose 宿主机端口；服务内始终使用 mysql:3306 / api:8000。
# Compose 固定仅绑定 127.0.0.1；当前网页默认 8503，避免覆盖现有 8502 预览。
MYSQL_HOST_PORT=3307
API_HOST_PORT=8000
FRONTEND_HOST_PORT=8503
